# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Supports Local PostgreSQL or Neon DB Serverless)
# Local: postgresql://postgres:postgres@localhost:5432/mcp_webanalyzer
# Neon DB: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_webanalyzer

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=openai/gpt-4o-mini

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000

# Crawl Configuration
MAX_PAGES=10
CRAWL_TIMEOUT_MS=30000
